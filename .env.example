# Backend API base URL. If empty, forms run in DEMO mode (saved in browser only).
VITE_API_URL=
# Set to false before launch to hide all content that is still waiting for client verification.
VITE_DRAFT_MODE=true
# Optional: Cloudflare Turnstile site key for spam protection (backend must verify the token).
VITE_TURNSTILE_SITE_KEY=
